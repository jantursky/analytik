[
  {
    "name": "Tracker script (analytik.js)",
    "path": "dist/analytik.js",
    "gzip": true,
    "limit": "4 kB"
  },
  {
    "name": "Browser client",
    "path": "dist/client.js",
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "React bindings",
    "path": "dist/react.js",
    "ignore": ["react", "react-dom"],
    "gzip": true,
    "limit": "6 kB"
  },
  {
    "name": "Dashboard with its lazy chunks, flags and every language catalog included (Base UI, Motion and Recharts are peers)",
    "path": "dist/dashboard.js",
    "ignore": ["react", "react-dom", "@base-ui/react", "motion", "recharts"],
    "gzip": true,
    "limit": "360 kB"
  },
  {
    "name": "Language catalogs, all together (each is a lazy chunk of about 14 kB for one of seventeen languages, loaded only for that language)",
    "path": "dist/chunks/{sk,cs,de,es,fr,pt,pl,it,nl,ru,tr,ja,zh,ko,id,hi,vi}-*.js",
    "gzip": true,
    "limit": "250 kB"
  },
  {
    "name": "Country flags (a lazy chunk, loaded when the first country is shown)",
    "path": "dist/chunks/flags-data-*.js",
    "gzip": true,
    "limit": "42 kB"
  },
  {
    "name": "Dashboard styles",
    "path": "dist/dashboard.css",
    "gzip": true,
    "limit": "13.5 kB"
  },
  {
    "name": "Standalone dashboard, tracker and wrapper (everything a Worker serves; hono is a peer)",
    "path": "dist/standalone.js",
    "ignore": ["hono"],
    "gzip": true,
    "limit": "700 kB"
  },
  {
    "name": "Server (the test data generator is a lazy chunk, counted here)",
    "path": "dist/server.js",
    "ignore": ["hono"],
    "gzip": true,
    "limit": "28 kB"
  },
  {
    "name": "D1 storage",
    "path": "dist/storage/d1.js",
    "gzip": true,
    "limit": "3 kB"
  },
  {
    "name": "Postgres storage",
    "path": "dist/storage/postgres.js",
    "gzip": true,
    "limit": "3 kB"
  },
  {
    "name": "Payment adapters",
    "path": ["dist/adapters/stripe.js", "dist/adapters/dodo.js", "dist/adapters/lemonsqueezy.js"],
    "gzip": true,
    "limit": "4 kB"
  },
  {
    "name": "Demo data and storage opener",
    "path": "dist/migrate.js",
    "ignore": ["postgres"],
    "gzip": true,
    "limit": "8 kB"
  }
]
