[
  {
    "name": "Tracker script (analytik.js)",
    "path": "dist/analytik.js",
    "gzip": true,
    "limit": "4 kB"
  },
  {
    "name": "Browser client",
    "path": "dist/client.js",
    "gzip": true,
    "limit": "5 kB"
  },
  {
    "name": "React bindings",
    "path": "dist/react.js",
    "ignore": ["react", "react-dom"],
    "gzip": true,
    "limit": "6 kB"
  },
  {
    "name": "Dashboard with its lazy chunks (Base UI, Motion and Recharts are peers)",
    "path": "dist/dashboard.js",
    "ignore": ["react", "react-dom", "@base-ui/react", "motion", "recharts"],
    "gzip": true,
    "limit": "64 kB"
  },
  {
    "name": "Dashboard styles",
    "path": "dist/dashboard.css",
    "gzip": true,
    "limit": "13 kB"
  },
  {
    "name": "Standalone dashboard, tracker and wrapper (everything a Worker serves; hono is a peer)",
    "path": "dist/standalone.js",
    "ignore": ["hono"],
    "gzip": true,
    "limit": "420 kB"
  },
  {
    "name": "Server (the test data generator is a lazy chunk, counted here)",
    "path": "dist/server.js",
    "ignore": ["hono"],
    "gzip": true,
    "limit": "28 kB"
  },
  {
    "name": "D1 storage",
    "path": "dist/storage/d1.js",
    "gzip": true,
    "limit": "3 kB"
  },
  {
    "name": "Postgres storage",
    "path": "dist/storage/postgres.js",
    "gzip": true,
    "limit": "3 kB"
  },
  {
    "name": "Payment adapters",
    "path": ["dist/adapters/stripe.js", "dist/adapters/dodo.js", "dist/adapters/lemonsqueezy.js"],
    "gzip": true,
    "limit": "4 kB"
  },
  {
    "name": "Demo data and storage opener",
    "path": "dist/migrate.js",
    "ignore": ["postgres"],
    "gzip": true,
    "limit": "8 kB"
  }
