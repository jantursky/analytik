{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // The demo's server files (tested from here) import the package by name; point that at the sources, not at dist.
    "paths": { "analytik/server": ["./src/server"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "vitest.workers.config.ts"
  ]
}
