{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "bun run sync:changelog && blume dev",
    "build": "bun run sync:changelog && blume build",
    "preview": "blume preview",
    "doctor": "blume doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:changelog": "mkdir -p docs/_generated && sed 1,2d ../../packages/analytik/CHANGELOG.md > docs/_generated/changelog.md"
  },
  "dependencies": {
    "analytik": "workspace:*",
    "blume": "^2.2.6",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "~5.9.3"
  }
}
